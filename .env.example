# Docker 部署配置（复制为 .env）
# 必填。填你核对过的版本标签。留空时 compose 拒绝启动。不要填 latest。
# 本加固只改源码，不发布新镜像；标签对应的镜像内容需要你自行核对。
POJUN_TAG=
# 镜像名：默认 ghcr.io/chu0119/pojun（amd64/arm64 双架构，CI 随版本发布）
# POJUN_IMAGE=ghcr.io/chu0119/pojun
POSTGRES_USER=pojun
# 必填，且不要沿用任何示例口令。留空时 compose 的 :? 会拒绝启动。
# 本文件不提供可用的默认密码。已有部署的库口令不会被这里改写。
POSTGRES_PASSWORD=
POSTGRES_DB=pojun

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
POJUN_LLM_PROVIDER=
POJUN_LLM_MODEL=
POJUN_LLM_BASE_URL=
POJUN_LLM_PROXY=
